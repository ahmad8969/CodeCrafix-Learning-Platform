PORT=5000
MONGO_URI=mongodb://localhost:27017/codecrafters
JWT_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_REMEMBER=30d
JWT_ISSUER=codecrafters-api
JWT_AUDIENCE=codecrafters-web
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development
TRUST_PROXY=0
ENABLE_SWAGGER=true
MULTI_TENANT=false
LOG_LEVEL=debug
COOKIE_SAME_SITE=lax
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
VERIFY_RATE_LIMIT_MAX=60
