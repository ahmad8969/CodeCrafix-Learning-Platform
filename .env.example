NODE_ENV=production
CLIENT_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=1
ENABLE_SWAGGER=false
MULTI_TENANT=false
LOG_LEVEL=info

# Mongo
MONGO_URI=mongodb://mongo:27017/codecrafters
MONGO_ROOT_USER=codecrafters
MONGO_ROOT_PASSWORD=replace_with_strong_password

# JWT (min 32 chars, distinct)
JWT_ACCESS_SECRET=replace_with_long_random_access_secret_value
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret_value
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_REMEMBER=30d
JWT_ISSUER=codecrafters-api
JWT_AUDIENCE=codecrafters-web

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
VERIFY_RATE_LIMIT_MAX=30

# Backup
BACKUP_DIR=./backups
